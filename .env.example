# Supabase — copy to .env.local and fill in. Never commit .env.local.

# Must be *.supabase.co — never *.supabase.co.il (invalid host; breaks Google OAuth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: server-side only (never expose in client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgres://postgres:password@db.xxx.supabase.co:6543/postgres
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# PayPlus (payment link for return/replacement top-up)
PAYPLUS_API_KEY=your-payplus-api-key
PAYPLUS_SECRET_KEY=your-payplus-secret-key
PAYPLUS_PAYMENT_PAGE_UID=your-payment-page-uid

# App URL for PayPlus redirects and confirm links (default: https://csreturns.vercel.app)
NEXT_PUBLIC_APP_URL=https://csreturns.vercel.app

# Optional: staff Google OAuth return origin when tab URL ≠ whitelisted callback (local dev).
# Example: browsing http://127.0.0.1:3000 but Supabase only allows http://localhost:3000/auth/callback
# NEXT_PUBLIC_STAFF_OAUTH_REDIRECT_ORIGIN=http://localhost:3000
